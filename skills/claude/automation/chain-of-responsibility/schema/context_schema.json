{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SharedContext",
  "description": "Mutable state memory persisted on disk, passed from handler to handler.",
  "type": "OBJECT",
  "properties": {
    "request": {
      "type": "OBJECT",
      "properties": {
        "task_description": { "type": "STRING" },
        "input_data": { "type": "STRING" }
      },
      "required": ["task_description", "input_data"]
    },
    "payload": {
      "type": "OBJECT",
      "properties": {
        "current_output": { "type": "STRING" },
        "metadata": { "type": "OBJECT" }
      },
      "required": ["current_output", "metadata"]
    },
    "telemetry": {
      "type": "OBJECT",
      "properties": {
        "execution_count": {
          "type": "OBJECT",
          "description": "Tracks the number of times each handler has been executed in the current cycle.",
          "additionalProperties": { "type": "INTEGER" }
        },
        "current_step": { "type": "INTEGER" }
      },
      "required": ["execution_count", "current_step"]
    },
    "log": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "handler": { "type": "STRING" },
          "action": { "type": "STRING" },
          "timestamp": { "type": "STRING" }
        },
        "required": ["handler", "action", "timestamp"]
      }
    },
    "errors": {
      "type": "ARRAY",
      "items": { "type": "STRING" }
    }
  },
  "required": ["request", "payload", "telemetry", "log", "errors"]
}
